@page "/check-in"
@using Gym.Application.CheckIns.Contracts
@using Gym.WebUI.Services.CheckIns
@inject ICheckInApiClient CheckInApiClient

<PageTitle>Member check-in</PageTitle>

<div class="check-in-page">
    <header class="check-in-header">
        <span class="eyebrow">Front desk</span>
        <h1>Member check-in</h1>
        <p>Find a member, confirm the selected branch, and welcome them in.</p>
    </header>

    <div class="check-in-grid">
        <section class="check-in-card" aria-labelledby="lookup-heading">
            <div class="step-heading">
                <span class="step-number">1</span>
                <div>
                    <h2 id="lookup-heading">Find the member</h2>
                    <p>Use their member code or normalized phone number.</p>
                </div>
            </div>

            <form @onsubmit="ReviewCheckIn" @onsubmit:preventDefault>
                <div class="form-group">
                    <label for="member-lookup">Member code or phone</label>
                    <input id="member-lookup"
                           class="form-control form-control-lg"
                           placeholder="e.g. M000123 or 84901234567"
                           autocomplete="off"
                           required
                           @bind="memberLookup"
                           @bind:event="oninput" />
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="tenant-id">Tenant ID</label>
                        <input id="tenant-id"
                               class="form-control"
                               placeholder="Tenant UUID"
                               required
                               @bind="tenantIdText"
                               @bind:event="oninput" />
                    </div>
                    <div class="form-group col-md-6">
                        <label for="branch-id">Selected branch</label>
                        <input id="branch-id"
                               class="form-control"
                               placeholder="Branch UUID"
                               required
                               @bind="branchIdText"
                               @bind:event="oninput" />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label for="check-in-note">Note <span class="optional">Optional</span></label>
                    <textarea id="check-in-note"
                              class="form-control"
                              rows="2"
                              maxlength="500"
                              placeholder="Add a note for the front desk"
                              @bind="note"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <div class="alert alert-danger" role="alert">@validationMessage</div>
                }

                <button class="btn btn-primary btn-lg btn-block" type="submit">
                    Review check-in
                    <span class="oi oi-arrow-right ml-2" aria-hidden="true"></span>
                </button>
            </form>
        </section>

        <aside class="confirmation-card" aria-labelledby="confirmation-heading">
            <div class="step-heading">
                <span class="step-number">2</span>
                <div>
                    <h2 id="confirmation-heading">Confirm check-in</h2>
                    <p>Review the details before recording attendance.</p>
                </div>
            </div>

            @if (response?.IsSuccess == true)
            {
                <div class="success-result" role="status">
                    <span class="success-icon oi oi-check" aria-hidden="true"></span>
                    <h3>Check-in successful</h3>
                    <p>The member is cleared to enter.</p>
                    <dl>
                        <dt>Check-in ID</dt>
                        <dd>@response.CheckInId</dd>
                        <dt>Branch</dt>
                        <dd>@confirmedBranchId</dd>
                    </dl>
                    <button class="btn btn-outline-success" type="button" @onclick="StartAnotherCheckIn">
                        Check in another member
                    </button>
                </div>
            }
            else if (isReadyToConfirm)
            {
                <div class="confirmation-details">
                    <span>Member</span>
                    <strong>@memberLookup.Trim()</strong>
                    <span>Selected branch</span>
                    <strong>@branchId</strong>
                    @if (!string.IsNullOrWhiteSpace(note))
                    {
                        <span>Note</span>
                        <strong>@note.Trim()</strong>
                    }
                </div>

                @if (!string.IsNullOrEmpty(apiMessage))
                {
                    <div class="alert alert-danger" role="alert">@apiMessage</div>
                }

                <button class="btn btn-success btn-lg btn-block"
                        type="button"
                        disabled="@isSubmitting"
                        @onclick="ConfirmCheckInAsync">
                    @(isSubmitting ? "Checking in…" : "Confirm check-in")
                </button>
                <button class="btn btn-link btn-block" type="button" disabled="@isSubmitting" @onclick="EditDetails">
                    Edit details
                </button>
            }
            else
            {
                <div class="empty-confirmation">
                    <span class="oi oi-clipboard" aria-hidden="true"></span>
                    <p>Enter the member and branch details to prepare this check-in.</p>
                </div>
            }
        </aside>
    </div>
</div>

@code {
    private string memberLookup = string.Empty;
    private string tenantIdText = string.Empty;
    private string branchIdText = string.Empty;
    private string? note;
    private string? validationMessage;
    private string? apiMessage;
    private Guid tenantId;
    private Guid branchId;
    private Guid? confirmedBranchId;
    private bool isReadyToConfirm;
    private bool isSubmitting;
    private CheckInApiResponse? response;

    private void ReviewCheckIn()
    {
        validationMessage = null;
        apiMessage = null;
        response = null;

        if (string.IsNullOrWhiteSpace(memberLookup))
        {
            validationMessage = "Enter a member code or phone number.";
            isReadyToConfirm = false;
            return;
        }

        if (!Guid.TryParse(tenantIdText, out tenantId))
        {
            validationMessage = "Enter a valid tenant ID.";
            isReadyToConfirm = false;
            return;
        }

        if (!Guid.TryParse(branchIdText, out branchId))
        {
            validationMessage = "Select a valid branch.";
            isReadyToConfirm = false;
            return;
        }

        isReadyToConfirm = true;
    }

    private async Task ConfirmCheckInAsync()
    {
        if (!isReadyToConfirm || isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        apiMessage = null;

        try
        {
            response = await CheckInApiClient.CheckInAsync(
                tenantId,
                branchId,
                new CheckInApiRequest(memberLookup.Trim(), NormalizeNote(note)));

            if (response.IsSuccess)
            {
                confirmedBranchId = branchId;
                isReadyToConfirm = false;
            }
            else
            {
                apiMessage = "This member could not be checked in. Please verify their membership details.";
            }
        }
        catch (Exception)
        {
            apiMessage = "The check-in service is unavailable. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void EditDetails()
    {
        isReadyToConfirm = false;
        apiMessage = null;
    }

    private void StartAnotherCheckIn()
    {
        memberLookup = string.Empty;
        note = null;
        response = null;
        apiMessage = null;
        validationMessage = null;
        confirmedBranchId = null;
        isReadyToConfirm = false;
    }

    private static string? NormalizeNote(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
