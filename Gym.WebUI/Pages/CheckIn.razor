@page "/check-in"
@using Gym.WebUI.Services.Prototype
@inject IPrototypeGymState State
@inject Gym.WebUI.Services.Ui.IAppShellState Shell

<PageTitle>Check-in · GymOS</PageTitle>
<UiPageHeader Eyebrow="Front desk" Title="Member check-in" Description="@Description" />
<div class="checkin-workspace">
    <UiCard Title="Find member" Description="Enter a member code or phone number, then confirm eligibility."><form @onsubmit="Lookup" @onsubmit:preventDefault><label class="sr-only" for="member-lookup">Member code or phone</label><div class="checkin-lookup"><input @ref="lookupInput" id="member-lookup" class="form-control form-control-lg" placeholder="Member code or phone number" autocomplete="off" @bind="lookup" autofocus /><UiButton Type="submit">Review check-in</UiButton></div></form>@if (!string.IsNullOrWhiteSpace(lookupMessage)) { <div class="alert alert-danger" role="alert">@lookupMessage</div> }<p class="checkin-help">Selected branch: <strong>@Shell.SelectedBranch.Code · @Shell.SelectedBranch.Name</strong></p></UiCard>
    @if (Member is not null) { <UiCard Title="Member eligibility" Description="Review entitlement before recording attendance."><div class="member-summary"><span class="member-summary__avatar" aria-hidden="true">@Initials</span><div><h2>@Member.FullName</h2><p>@Member.MemberCode · @Member.PhoneNumber</p><UiStatusBadge Tone="@(Member.Status == "Active" ? UiTone.Success : UiTone.Warning)">@Member.Status</UiStatusBadge></div></div><dl class="detail-list"><dt>Subscription</dt><dd>@(Subscription?.PlanName ?? "No active subscription")</dd><dt>Validity</dt><dd>@(Subscription is null ? "—" : $"{Subscription.StartDate:dd MMM yyyy} – {Subscription.EndDate:dd MMM yyyy}")</dd><dt>Branch access</dt><dd>@BranchAccess</dd><dt>Entitlement</dt><dd>@(Subscription?.RemainingVisits?.ToString() ?? (Subscription is null ? "—" : "Unlimited"))</dd></dl>@if (result is null) { <UiButton OnClick="Confirm">Confirm check-in</UiButton> }</UiCard> }
    @if (result is not null) { @if (result.IsSuccess) { <UiCard Class="checkin-success" Title="Check-in successful" Description="The member is cleared to enter."><div class="checkin-success__icon" aria-hidden="true">✓</div><p><strong>@Member!.FullName</strong> checked in at @result.CheckIn!.CheckedInAt.ToLocalTime().ToString("HH:mm").</p><UiButton OnClick="StartAnother">Check in another member</UiButton></UiCard> } else { <UiCard Class="checkin-rejection" Title="Check-in not allowed"><p>@result.Message</p><a class="ui-button ui-button--secondary" href="@ActionHref">@ActionText</a><UiButton Variant="secondary" OnClick="StartAnother">Try another member</UiButton></UiCard> } }
    <UiCard Title="Recent check-ins" Description="Latest attendance at the selected branch."><UiDataTable Label="Recent check-ins"><thead><tr><th>Member</th><th>Time</th><th>Plan</th></tr></thead><tbody>@foreach (var item in State.CheckIns.Where(item => item.BranchId == Shell.SelectedBranch.Id).OrderByDescending(item => item.CheckedInAt).Take(8)) { <tr><td>@State.Members.Single(member => member.Id == item.MemberId).FullName</td><td>@item.CheckedInAt.ToLocalTime().ToString("HH:mm")</td><td>@State.Subscriptions.Single(subscription => subscription.Id == item.SubscriptionId).PlanName</td></tr> }</tbody></UiDataTable></UiCard>
</div>
@code { private string lookup = string.Empty, lookupMessage = string.Empty; private PrototypeMember? Member; private PrototypeCheckInResult? result; private ElementReference lookupInput; private string Description => $"Recording attendance at {Shell.SelectedBranch.Name}"; private PrototypeSubscription? Subscription => Member is null ? null : State.Subscriptions.LastOrDefault(item => item.MemberId == Member.Id && item.Status == "Active"); private string Initials => string.Concat(Member!.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])); private string BranchAccess => Subscription is null ? "No entitlement" : Subscription.AllowCrossBranch || Subscription.HomeBranchId == Shell.SelectedBranch.Id ? "Permitted at selected branch" : "Not permitted at selected branch"; private string ActionHref => result?.Message.Contains("branch", StringComparison.OrdinalIgnoreCase) == true ? "prototype/subscriptions" : $"prototype/members/{Member!.Id}"; private string ActionText => result?.Message.Contains("branch", StringComparison.OrdinalIgnoreCase) == true ? "Review subscription" : "Open member profile"; private void Lookup() { lookupMessage = string.Empty; result = null; Member = State.Members.SingleOrDefault(member => member.MemberCode.Equals(lookup.Trim(), StringComparison.OrdinalIgnoreCase) || member.PhoneNumber == lookup.Trim()); if (Member is null) lookupMessage = "No member matches that code or phone number."; } private void Confirm() => result = State.CheckIn(Member!.Id, Shell.SelectedBranch.Id); private async Task StartAnother() { lookup = string.Empty; lookupMessage = string.Empty; Member = null; result = null; await lookupInput.FocusAsync(); } }
