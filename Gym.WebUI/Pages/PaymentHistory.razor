@page "/prototype/payments"
@using Gym.WebUI.Services.Prototype
@implements IDisposable
@inject IPrototypeGymState State

<PageTitle>Payments · GymOS</PageTitle>
<UiPageHeader Eyebrow="Finance" Title="Payment history" Description="Prototype payment records for this browser session." />
<UiSearchFilterBar SearchText="@search" SearchTextChanged="value => search = value" Placeholder="Search payment number or member"><Filters><select class="form-control" @bind="memberId"><option value="">All members</option>@foreach (var member in State.Members) { <option value="@member.Id">@member.FullName</option> }</select><select class="form-control" @bind="status"><option value="">All statuses</option><option value="completed">Completed</option><option value="voided">Voided</option></select><input class="form-control" type="date" @bind="date" /></Filters></UiSearchFilterBar>
@if (!Payments.Any()) { <UiEmptyState Title="No payments found" Description="Change the filters to review other payment records." /> }
else { <UiDataTable Label="Payments"><thead><tr><th>Payment</th><th>Member</th><th>Amount</th><th>Paid at</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var payment in Payments) { <tr><td><button class="btn btn-link" @onclick="() => selected = payment">@payment.PaymentNo</button></td><td>@State.Members.Single(member => member.Id == payment.MemberId).FullName</td><td>@payment.Amount.ToString("N0") VND</td><td>@payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><UiStatusBadge Tone="@(payment.IsVoided ? UiTone.Danger : UiTone.Success)">@(payment.IsVoided ? "Voided" : "Completed")</UiStatusBadge></td><td>@if (!payment.IsVoided) { <button class="btn btn-link" @onclick="() => OpenVoid(payment)">Void</button> }</td></tr> }</tbody></UiDataTable> }
<UiDrawer IsOpen="@(selected is not null)" Title="Payment details" OnClose="() => selected = null">@if (selected is not null) { <dl class="detail-list"><dt>Payment</dt><dd>@selected.PaymentNo</dd><dt>Member</dt><dd>@State.Members.Single(member => member.Id == selected.MemberId).FullName</dd><dt>Amount</dt><dd>@selected.Amount.ToString("N0") VND</dd><dt>Method</dt><dd>@selected.Method</dd><dt>Status</dt><dd>@(selected.IsVoided ? $"Voided: {selected.VoidReason}" : "Completed")</dd></dl> }</UiDrawer>
<UiConfirmationModal IsOpen="@(voiding is not null)" Title="Void payment?" ConfirmText="Void payment" OnConfirm="ConfirmVoid" OnCancel="CloseVoid"><p>This prototype action is reversible only by resetting the browser session.</p><label class="prototype-label">Reason<textarea class="form-control" @bind="voidReason"></textarea></label>@if (showReasonError) { <UiValidationSummary Messages="@VoidReasonMessages" /> }</UiConfirmationModal>
@code { private string search = string.Empty, memberId = string.Empty, status = string.Empty; private DateOnly? date; private PrototypePayment? selected, voiding; private string voidReason = string.Empty; private bool showReasonError; private static readonly string[] VoidReasonMessages = ["A reason is required to void a payment."]; private IEnumerable<PrototypePayment> Payments => State.Payments.Where(payment => (string.IsNullOrWhiteSpace(search) || payment.PaymentNo.Contains(search, StringComparison.OrdinalIgnoreCase) || State.Members.Single(member => member.Id == payment.MemberId).FullName.Contains(search, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(memberId) || payment.MemberId == Guid.Parse(memberId)) && (string.IsNullOrWhiteSpace(status) || (status == "voided" ? payment.IsVoided : !payment.IsVoided)) && (!date.HasValue || DateOnly.FromDateTime(payment.PaidAt.LocalDateTime) == date)); protected override void OnInitialized() => State.Changed += Refresh; public void Dispose() => State.Changed -= Refresh; private void Refresh() => _ = InvokeAsync(StateHasChanged); private void OpenVoid(PrototypePayment payment) { voiding = payment; voidReason = string.Empty; showReasonError = false; } private void CloseVoid() { voiding = null; showReasonError = false; } private void ConfirmVoid() { if (string.IsNullOrWhiteSpace(voidReason)) { showReasonError = true; return; } State.VoidPayment(voiding!.Id, voidReason); CloseVoid(); } }
