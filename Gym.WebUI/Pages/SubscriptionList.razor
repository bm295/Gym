@page "/prototype/subscriptions"
@using Gym.WebUI.Services.Prototype
@implements IDisposable
@inject IPrototypeGymState State

<PageTitle>Subscriptions · GymOS</PageTitle>
<UiPageHeader Eyebrow="Sales & renewals" Title="Subscriptions" Description="Sell a plan or renew a member using immutable plan snapshots." />
<UiCard Title="Sell subscription" Description="This is a browser-session prototype transaction."><EditForm Model="sale" OnSubmit="Sell"><div class="prototype-form prototype-form--grid"><label>Member<select class="form-control" @bind="sale.MemberId">@foreach (var member in State.Members.Where(item => item.Status == "Active")) { <option value="@member.Id">@member.FullName</option> }</select></label><label>Plan<select class="form-control" @bind="sale.PlanId">@foreach (var plan in State.Plans.Where(item => item.Status == "Active")) { <option value="@plan.Id">@plan.Name · @plan.Price.ToString("N0") VND</option> }</select></label><label>Home branch<select class="form-control" @bind="sale.HomeBranchId">@foreach (var branch in State.Branches) { <option value="@branch.Id">@branch.Name</option> }</select></label><label>Start date<input class="form-control" type="date" @bind="sale.StartDate" /></label><label>Amount paid<input class="form-control" type="number" @bind="sale.AmountPaid" /></label><UiButton Type="submit">Sell plan</UiButton></div></EditForm></UiCard>
<UiDataTable Label="Subscriptions"><thead><tr><th>Member</th><th>Plan snapshot</th><th>Home branch</th><th>Dates</th><th>Visits</th><th>Paid</th><th>Activation</th><th></th></tr></thead><tbody>@foreach (var item in State.Subscriptions.OrderByDescending(item => item.StartDate)) { <tr><td>@State.Members.Single(member => member.Id == item.MemberId).FullName</td><td>@item.PlanName</td><td>@State.Branches.Single(branch => branch.Id == item.HomeBranchId).Name</td><td>@item.StartDate – @item.EndDate</td><td>@(item.RemainingVisits?.ToString() ?? "Unlimited")</td><td>@item.SalePrice.ToString("N0") VND</td><td><UiStatusBadge Tone="UiTone.Success">@item.Status</UiStatusBadge></td><td><button class="btn btn-link" @onclick="() => Renew(item)">Renew</button></td></tr> }</tbody></UiDataTable>
<UiDrawer IsOpen="@isRenewing" Title="Renew subscription" OnClose="() => isRenewing = false"><div class="prototype-form"><label>New plan<select class="form-control" @bind="renewPlanId">@foreach (var plan in State.Plans.Where(item => item.Status == "Active")) { <option value="@plan.Id">@plan.Name</option> }</select></label><label>New start date<input class="form-control" type="date" @bind="renewStartDate" /></label><UiButton OnClick="ConfirmRenew">Create renewal</UiButton></div></UiDrawer>
@code { private SellSubscriptionDraft sale = new(Guid.Parse("55555555-5555-5555-5555-555555555555"), Guid.Parse("88888888-8888-8888-8888-888888888888"), Guid.Parse("11111111-1111-1111-1111-111111111111"), DateOnly.FromDateTime(DateTime.Today), 500_000m); private bool isRenewing; private Guid renewingId, renewPlanId = Guid.Parse("88888888-8888-8888-8888-888888888888"); private DateOnly renewStartDate = DateOnly.FromDateTime(DateTime.Today); protected override void OnInitialized() => State.Changed += Refresh; public void Dispose() => State.Changed -= Refresh; private void Refresh() => _ = InvokeAsync(StateHasChanged); private void Sell() => State.SellSubscription(sale); private void Renew(PrototypeSubscription item) { renewingId = item.Id; renewStartDate = item.EndDate.AddDays(1); isRenewing = true; } private void ConfirmRenew() { State.RenewSubscription(renewingId, renewPlanId, renewStartDate); isRenewing = false; } }
