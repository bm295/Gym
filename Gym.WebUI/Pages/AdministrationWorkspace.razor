@page "/prototype/branches"
@page "/prototype/staff"
@page "/prototype/reports"
@page "/prototype/audit-log"
@using Gym.WebUI.Services.Prototype
@inject IPrototypeGymState State
@inject NavigationManager Navigation

<PageTitle>@Title · GymOS</PageTitle>
<UiPageHeader Eyebrow="Administration" Title="@Title" Description="@Description" />
@if (Module == "branches") { <UiSearchFilterBar SearchText="@search" SearchTextChanged="value => search = value" Placeholder="Search branch"><Filters><select class="form-control" @bind="active"><option value="">All statuses</option><option value="active">Active</option></select></Filters></UiSearchFilterBar>@if (!Branches.Any()) { <UiEmptyState Title="No branches found" Description="Change the branch filters." /> } else { <UiDataTable Label="Branches"><thead><tr><th>Branch</th><th>Code</th><th>Address</th><th>Status</th></tr></thead><tbody>@foreach (var branch in Branches) { <tr><td>@branch.Name</td><td>@branch.Code</td><td>@branch.Address</td><td><UiStatusBadge Tone="UiTone.Success">Active</UiStatusBadge></td></tr> }</tbody></UiDataTable> } }
else if (Module == "staff") { <UiSearchFilterBar SearchText="@search" SearchTextChanged="value => search = value" Placeholder="Search staff"><Filters><select class="form-control" @bind="staffBranch"><option value="">All branches</option>@foreach (var branch in State.Branches) { <option value="@branch.Id">@branch.Name</option> }</select></Filters></UiSearchFilterBar>@if (!Staff.Any()) { <UiEmptyState Title="No staff found" Description="Change the staff filters." /> } else { <UiDataTable Label="Staff"><thead><tr><th>Staff member</th><th>Role</th><th>Branch</th><th>Status</th></tr></thead><tbody>@foreach (var staff in Staff) { <tr><td>@staff.Name</td><td><UiStatusBadge Tone="UiTone.Info">@staff.Role</UiStatusBadge></td><td>@State.Branches.Single(branch => branch.Id == staff.BranchId).Name</td><td><UiStatusBadge Tone="UiTone.Success">Active</UiStatusBadge></td></tr> }</tbody></UiDataTable> } }
else if (Module == "reports") { <div class="dashboard-metrics">@foreach (var metric in State.Reports) { <UiCard Class="dashboard-metric"><span class="dashboard-metric__label">@metric.Label</span><strong>@metric.Value</strong><small>@metric.Trend</small></UiCard> }</div><UiCard Title="Report filters" Description="Reports are generated from prototype data for the current browser session."><UiStatusBadge Tone="UiTone.Info">Selected period: Today</UiStatusBadge></UiCard> }
else { <UiSearchFilterBar SearchText="@search" SearchTextChanged="value => search = value" Placeholder="Search audit action or summary" />@if (!AuditEntries.Any()) { <UiEmptyState Title="No audit activity yet" Description="Prototype actions such as creating a member or recording a payment will appear here." /> } else { <UiDataTable Label="Audit log"><thead><tr><th>When</th><th>Action</th><th>Summary</th><th>By</th></tr></thead><tbody>@foreach (var entry in AuditEntries) { <tr><td>@entry.OccurredAt.ToLocalTime().ToString("g")</td><td><UiStatusBadge Tone="UiTone.Info">@entry.Action</UiStatusBadge></td><td>@entry.Summary</td><td>@entry.PerformedBy</td></tr> }</tbody></UiDataTable> } }
@code { private string search = string.Empty, active = string.Empty, staffBranch = string.Empty; private string Module => Navigation.Uri.Split('/').Last(); private string Title => Module switch { "branches" => "Branches", "staff" => "Staff", "reports" => "Reports", _ => "Audit log" }; private string Description => "Administrative prototype workspace; changes are not persisted to the server."; private IEnumerable<PrototypeBranch> Branches => State.Branches.Where(branch => (string.IsNullOrWhiteSpace(search) || branch.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || branch.Code.Contains(search, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(active) || branch.IsActive)); private IEnumerable<PrototypeStaff> Staff => State.Staff.Where(staff => (string.IsNullOrWhiteSpace(search) || staff.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || staff.Role.Contains(search, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(staffBranch) || staff.BranchId == Guid.Parse(staffBranch))); private IEnumerable<PrototypeAuditEntry> AuditEntries => State.AuditEntries.Where(entry => string.IsNullOrWhiteSpace(search) || entry.Action.Contains(search, StringComparison.OrdinalIgnoreCase) || entry.Summary.Contains(search, StringComparison.OrdinalIgnoreCase)); }
