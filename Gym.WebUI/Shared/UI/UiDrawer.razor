@if (IsOpen)
{
    <div class="ui-overlay" role="presentation" @onclick="CloseAsync">
        <aside class="ui-drawer" role="dialog" aria-modal="true" aria-labelledby="@TitleId" @onclick:stopPropagation>
            <header>
                <h2 id="@TitleId">@Title</h2>
                <button class="ui-icon-button" aria-label="Close" @onclick="CloseAsync">×</button>
            </header>
            <div class="ui-drawer__body">@ChildContent</div>
        </aside>
    </div>
}

@code {
    private readonly string TitleId = $"drawer-{Guid.NewGuid():N}";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
