@if (Messages.Any())
{
    <div class="ui-validation-summary" role="alert">
        <strong>@Title</strong>
        <ul>
            @foreach (var message in Messages)
            {
                <li>@message</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Please review the highlighted fields.";
    [Parameter] public IEnumerable<string> Messages { get; set; } = [];
}
